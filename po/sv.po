msgstr "[albumartist]/[album]/[skiv- och spårnummer] [artist] - [titel]"

#: picard/script/functions.py:75
msgid "$if(if,then[,else])"
msgstr "$if(if,then[,else])"

#: picard/script/functions.py:76
msgid "If `if` is not empty, it returns `then`, otherwise it returns `else`."
msgstr "Om `if` inte är tomt returneras `then`, annars returneras `else`."

#: picard/script/functions.py:88
msgid "$if2(a1,a2,a3,…)"
msgstr "$if2(a1,a2,a3,…)"

#: picard/script/functions.py:89
msgid "Returns first non empty argument."
msgstr "Returnerar det första argumentet som inte är tomt."

#: picard/script/functions.py:101
msgid "Does nothing (useful for comments or disabling a block of code)."
msgstr ""
"Gör ingenting (användbart för kommentarer eller för att inaktivera ett "
"kodblock)."

#: picard/script/functions.py:108
msgid "$left(text,number)"
msgstr "$left(text,number)"

#: picard/script/functions.py:109
msgid "Returns the first `number` characters from `text`."
msgstr "Returnerar de första `number` tecknen från `text`."

#: picard/script/functions.py:119
msgid "$right(text,number)"
msgstr "$right(text,number)"

#: picard/script/functions.py:120
msgid "Returns the last `number` characters from `text`."
msgstr "Returnerar de sista `number` tecknen från `text`."

#: picard/script/functions.py:130
msgid "$lower(text)"
msgstr "$lower(text)"

#: picard/script/functions.py:131
msgid "Returns `text` in lower case."
msgstr "Returnerar `text` med gemener."

#: picard/script/functions.py:138
msgid "$upper(text)"
msgstr "$upper(text)"

#: picard/script/functions.py:139
msgid "Returns `text` in upper case."
msgstr "Returnerar `text` med versaler."

#: picard/script/functions.py:146
msgid "$pad(text,length,char)"
msgstr "$pad(text,length,char)"

#: picard/script/functions.py:148
msgid ""
"Pads the `text` to the `length` provided by adding as many copies of `char` "
"as needed to the **beginning** of the string."
msgstr ""
"Fyller ut `text` till angiven `length` genom att lägga till så många kopior "
"av `char` som behövs i **början** av strängen."

#: picard/script/functions.py:160
msgid "$strip(text)"
msgstr "$strip(text)"

#: picard/script/functions.py:162
msgid ""
"Replaces all whitespace in `text` with a single space, and removes leading "
"and trailing spaces.\n"
"Whitespace characters include multiple consecutive spaces, and various other "
"unicode characters."
msgstr ""
"Ersätter alla blanktecken i `text` med ett enda blanksteg och tar bort "
"inledande och avslutande blanksteg.\n"
"Blanktecken omfattar flera efterföljande blanksteg och olika andra Unicode-"
"tecken."

#: picard/script/functions.py:171
msgid "$replace(text,search,replace)"
msgstr "$replace(text,search,replace)"

#: picard/script/functions.py:173
msgid ""
"Replaces occurrences of `search` in `text` with value of `replace` and "
"returns the resulting string."
msgstr ""
"Ersätter förekomster av `search` i `text` med värdet i `replace` och "
"returnerar den resulterande strängen."

#: picard/script/functions.py:182
msgid "$replacemulti(name,search,replace[,separator=; ])"
msgstr "$replacemulti(name,search,replace[,separator=; ])"

#: picard/script/functions.py:184
#, python-format
msgid ""
"Replaces occurrences of `search` with `replace` in the multi-value variable "
"`name`.\n"
"Empty elements are automatically removed.\n"
"\n"
"Example:\n"
"\n"
"    $replacemulti(%genre%,Idm,IDM)\n"
msgstr ""
"Ersätter förekomster av `search` med `replace` i flervärdesvariabeln "
"`name`.\n"
"Tomma element tas bort automatiskt.\n"
"\n"
"Exempel:\n"
"\n"
"    $replacemulti(%genre%,Idm,IDM)\n"

#: picard/script/functions.py:208
msgid "$in(x,y)"
msgstr "$in(x,y)"

#: picard/script/functions.py:209
msgid "Returns true, if `x` contains `y`."
msgstr "Returnerar sant om `x` innehåller `y`."

#: picard/script/functions.py:220
#, python-format
msgid "$inmulti(%x%,y)"
msgstr "$inmulti(%x%,y)"

#: picard/script/functions.py:222
msgid ""
"Returns true if multi-value variable `x` contains exactly `y` as one of its "
"values.\n"
"\n"
"_Since Picard 1.0_"
msgstr ""
"Returnerar sant om flervärdesvariabeln `x` innehåller exakt `y` som ett av "
"sina värden.\n"
"\n"
"_Sedan Picard 1.0_"

#: picard/script/functions.py:238
msgid "$rreplace(text,pattern,replace)"
msgstr "$rreplace(text,pattern,replace)"

#: picard/script/functions.py:240
msgid ""
"[Regular expression](https://docs.python.org/3/library/re.html#regular-"
"expression-syntax) replace."
msgstr ""
"Ersättning med [reguljärt uttryck](https://docs.python.org/3/library/"
"re.html#regular-expression-syntax)."

#: picard/script/functions.py:251
msgid "$rsearch(text,pattern[,group])"
msgstr "$rsearch(text,pattern[,group])"

#: picard/script/functions.py:253
msgid ""
"[Regular expression](https://docs.python.org/3/library/re.html#regular-"
"expression-syntax) search.\n"
"\n"
"If the optional `group` parameter is not provided or is empty, return the "
"first\n"
"capture group which matched something (including the empty string) or the\n"
"entire match.\n"
"\n"
"If `group` is an integer, return the capture group in the position matching "
"this integer.\n"
"Otherwise, return the capture group named `group`, sans surrounding "
"whitespace.\n"
"\n"
"Examples:\n"
"\n"
"    $rsearch(disc: 1,disc: \\(\\\\d+\\)) => \"1\"\n"
"    $rsearch(disc: 2,\\(\\\\w+\\): \\(\\\\d+\\),1) => \"disc\"\n"
"    $rsearch(disc: 3,\\(\\\\w+\\): \\(\\\\d+\\),2) => \"3\"\n"
"    $rsearch(disc: 4,disc: \\(?P<disc>\\\\d+\\),disc) => \"4\"\n"
"    $rsearch(disc: none,disc\\(: \\\\d+\\)?) => \"disc\"\n"
"    $rsearch(disc: /5,disc: \\(\\\\d+\\)?/\\\\d+,1) => \"\"\n"
"\n"
"_group parameter since Picard 3.0_"
msgstr ""
"Sökning med [reguljärt uttryck](https://docs.python.org/3/library/"
"re.html#regular-expression-syntax).\n"
"\n"
"Om den valfria parametern `group` inte anges eller är tom returneras den "
"första\n"
"fångstgruppen som matchade något (även en tom sträng), eller hela "
"matchningen.\n"
"\n"
"Om `group` är ett heltal returneras fångstgruppen på motsvarande position.\n"
"Annars returneras fångstgruppen med namnet `group`, utan omgivande "
"blanksteg.\n"
"\n"
"Exempel:\n"
"\n"
"    $rsearch(disc: 1,disc: \\(\\\\d+\\)) => \"1\"\n"
"    $rsearch(disc: 2,\\(\\\\w+\\): \\(\\\\d+\\),1) => \"disc\"\n"
"    $rsearch(disc: 3,\\(\\\\w+\\): \\(\\\\d+\\),2) => \"3\"\n"
"    $rsearch(disc: 4,disc: \\(?P<disc>\\\\d+\\),disc) => \"4\"\n"
"    $rsearch(disc: none,disc\\(: \\\\d+\\)?) => \"disc\"\n"
"    $rsearch(disc: /5,disc: \\(\\\\d+\\)?/\\\\d+,1) => \"\"\n"
"\n"
"_parametern group sedan Picard 3.0_"

#: picard/script/functions.py:299
msgid "$num(number,length)"
msgstr "$num(number,length)"

#: picard/script/functions.py:300
msgid "Returns `number` formatted to `length` digits (maximum 20)."
msgstr "Returnerar `number` formaterat till `length` siffror (högst 20)."

#: picard/script/functions.py:315
msgid "$unset(name)"
msgstr "$unset(name)"

#: picard/script/functions.py:317
msgid ""
"Unsets the variable `name`.\n"
"Allows for wildcards to unset certain tags (works with \"performer:\\*\", "
"\"comment:\\*\", and \"lyrics:\\*\").\n"
"For example `$unset(performer:*)` would unset all performer tags."
msgstr ""
"Tar bort variabeln `name`.\n"
"Jokertecken kan användas för att ta bort vissa taggar (fungerar med "
"\"performer:\\*\", \"comment:\\*\" och \"lyrics:\\*\").\n"
"Exempelvis tar `$unset(performer:*)` bort alla utövartaggar."

#: picard/script/functions.py:336
msgid "$delete(name)"
msgstr "$delete(name)"

#: picard/script/functions.py:338
msgid ""
"Unsets the variable `name` and marks the tag for deletion.\n"
"This is similar to `$unset(name)` but also marks the tag for deletion. E.g.\n"
"    running `$delete(genre)` will actually remove the genre tag from a file "
"when\n"
"    saving.\n"
"\n"
"_Since Picard 2.1_"
msgstr ""
"Tar bort variabeln `name` och markerar taggen för borttagning.\n"
"Detta liknar `$unset(name)`, men markerar även taggen för borttagning. Om du "
"till exempel\n"
"    kör `$delete(genre)` tas genretaggen faktiskt bort från filen när\n"
"    den sparas.\n"
"\n"
"_Sedan Picard 2.1_"

#: picard/script/functions.py:352
msgid "$set(name,value)"
msgstr "$set(name,value)"

#: picard/script/functions.py:354
#, python-format
msgid ""
"Sets the variable `name` to `value`.\n"
"\n"
"Note: To create a variable which can be used for the file naming string, "
"but\n"
"    which will not be written as a tag in the file, prefix the variable "
"name\n"
"    with an underscore. `%something%` will create a \"something\" tag;\n"
"    `%_something%` will not."
msgstr ""
"Ställer in variabeln `name` på `value`.\n"
"\n"
"Observera: Om du vill skapa en variabel som kan användas i filnamnssträngen "
"men\n"
"    inte skrivas som en tagg i filen ska variabelnamnet börja med ett "
"understreck.\n"
"    `%something%` skapar taggen \"something\"; `%_something%` gör det inte."

#: picard/script/functions.py:371
msgid "$setmulti(name,value[,separator=; ])"
msgstr "$setmulti(name,value[,separator=; ])"

#: picard/script/functions.py:373
#, python-format
msgid ""
"Sets the variable `name` to `value`, using the separator (or \"; \" if not "
"passed)\n"
"    to coerce the value back into a proper multi-valued tag. This can be "
"used to\n"
"    operate on multi-valued tags as a string, and then set them back as "
"proper\n"
"    multi-valued tags.\n"
"\n"
"Example:\n"
"\n"
"    $setmulti(genre,$lower(%genre%))\n"
"\n"
"_Since Picard 1.0_"
msgstr ""
"Ställer in variabeln `name` på `value` och använder avgränsaren (eller \"; "
"\" om den inte anges)\n"
"    för att konvertera värdet tillbaka till en korrekt flervärdestagg. "
"Funktionen kan användas för att\n"
"    bearbeta flervärdestaggar som strängar och sedan återställa dem som "
"korrekta\n"
"    flervärdestaggar.\n"
"\n"
"Exempel:\n"
"\n"
"    $setmulti(genre,$lower(%genre%))\n"
"\n"
"_Sedan Picard 1.0_"

#: picard/script/functions.py:390
msgid "$get(name)"
msgstr "$get(name)"

#: picard/script/functions.py:391
msgid "Returns the variable `name` (equivalent to `%name%`)."
msgstr "Returnerar variabeln `name` (motsvarar `%name%`)."

#: picard/script/functions.py:399
msgid "$copy(new,old)"
msgstr "$copy(new,old)"

#: picard/script/functions.py:401
#, python-format
msgid ""
"Copies metadata from variable `old` to `new`.\n"
"The difference between `$set(new,%old%)` is that `$copy(new,old)` copies\n"
"    multi-value variables without flattening them.\n"
"\n"
"_Since Picard 0.9_"
msgstr ""
"Kopierar metadata från variabeln `old` till `new`.\n"
"Skillnaden mot `$set(new,%old%)` är att `$copy(new,old)` kopierar\n"
"    flervärdesvariabler utan att platta ut dem.\n"
"\n"
"_Sedan Picard 0.9_"

#: picard/script/functions.py:416
msgid "$copymerge(new,old[,keep_duplicates])"
msgstr "$copymerge(new,old[,keep_duplicates])"

#: picard/script/functions.py:418
msgid ""
"Merges metadata from variable `old` into `new`, removing duplicates and\n"
"    appending to the end, so retaining the original ordering. Like `$copy`, "
"this\n"
"    will also copy multi-valued variables without flattening them.\n"
"\n"
"If `keep_duplicates` is set, then the duplicates will not be removed from "
"the result.\n"
"\n"
"_Since Picard 1.0_"
msgstr ""
"Slår samman metadata från variabeln `old` med `new`, tar bort dubbletter "
"och\n"
"    lägger till värdena sist så att den ursprungliga ordningen behålls. "
"Liksom `$copy`\n"
"    kopierar funktionen flervärdesvariabler utan att platta ut dem.\n"
"\n"
"Om `keep_duplicates` anges tas dubbletter inte bort från resultatet.\n"
"\n"
"_Sedan Picard 1.0_"

#: picard/script/functions.py:437
msgid "$trim(text[,char])"
msgstr "$trim(text[,char])"

#: picard/script/functions.py:439
msgid ""
"Trims all leading and trailing whitespaces from `text`.\n"
"    The optional second parameter `char` specifies the character to trim."
msgstr ""
"Tar bort alla inledande och avslutande blanktecken från `text`.\n"
"    Den valfria andra parametern `char` anger vilket tecken som ska tas bort."

#: picard/script/functions.py:452
msgid ""
"Add `y` to `x`.\n"
"Can be used with an arbitrary number of arguments.\n"
"\n"
"Example:\n"
"\n"
"    $add(x,y,z) = ((x + y) + z)\n"
msgstr ""
"Lägger till `y` i `x`.\n"
"Kan användas med valfritt antal argument.\n"
"\n"
"Exempel:\n"
"\n"
"    $add(x,y,z) = ((x + y) + z)\n"

#: picard/script/functions.py:470
msgid ""
"Subtracts `y` from `x`.\n"
"Can be used with an arbitrary number of arguments.\n"
"\n"
"Example:\n"
"\n"
"    $sub(x,y,z) = ((x - y) - z)\n"
msgstr ""
"Subtraherar `y` från `x`.\n"
"Kan användas med valfritt antal argument.\n"
"\n"
"Exempel:\n"
"\n"
"    $sub(x,y,z) = ((x - y) - z)\n"

#: picard/script/functions.py:488
msgid ""
"Divides `x` by `y`.\n"
"Can be used with an arbitrary number of arguments.\n"
"\n"
"Example:\n"
"\n"
"    $div(x,y,z) = ((x / y) / z)\n"
msgstr ""
"Dividerar `x` med `y`.\n"
"Kan användas med valfritt antal argument.\n"
"\n"
"Exempel:\n"
"\n"
"    $div(x,y,z) = ((x / y) / z)\n"

#: picard/script/functions.py:508
msgid ""
"Returns the remainder of `x` divided by `y`.\n"
"Can be used with an arbitrary number of arguments.\n"
"\n"
"Example:\n"
"\n"
"    $mod(x,y,z) = ((x % y) % z)\n"
msgstr ""
"Returnerar resten när `x` divideras med `y`.\n"
"Kan användas med valfritt antal argument.\n"
"\n"
"Exempel:\n"
"\n"
"    $mod(x,y,z) = ((x % y) % z)\n"

#: picard/script/functions.py:526
msgid ""
"Multiplies `x` by `y`.\n"
"Can be used with an arbitrary number of arguments.\n"
"\n"
"Example:\n"
"\n"
"    $mul(x,y,z) = ((x * y) * z)\n"
msgstr ""
"Multiplicerar `x` med `y`.\n"
"Kan användas med valfritt antal argument.\n"
"\n"
"Exempel:\n"
"\n"
"    $mul(x,y,z) = ((x * y) * z)\n"

#: picard/script/functions.py:544
msgid ""
"Returns true if either `x` or `y` not empty.\n"
"    Can be used with an arbitrary number of arguments.\n"
"    The result is true if **any** of the arguments is not empty."
msgstr ""
"Returnerar sant om antingen `x` eller `y` inte är tomt.\n"
"    Kan användas med valfritt antal argument.\n"
"    Resultatet är sant om **något** av argumenten inte är tomt."

#: picard/script/functions.py:558
msgid ""
"Returns true if both `x` and `y` are not empty.\n"
"    Can be used with an arbitrary number of arguments.\n"
"    The result is true if **all** of the arguments are not empty."
msgstr ""
"Returnerar sant om både `x` och `y` inte är tomma.\n"
"    Kan användas med valfritt antal argument.\n"
"    Resultatet är sant om **alla** argument inte är tomma."

#: picard/script/functions.py:571
msgid "Returns true if `x` is empty."
msgstr "Returnerar sant om `x` är tomt."

#: picard/script/functions.py:581
msgid "Returns true if `x` equals `y`."
msgstr "Returnerar sant om `x` är lika med `y`."

#: picard/script/functions.py:591
msgid "Returns true if `x` does not equal `y`."
msgstr "Returnerar sant om `x` inte är lika med `y`."

#: picard/script/functions.py:634
msgid "$lt(x,y[,type])"
msgstr "$lt(x,y[,type])"

#: picard/script/functions.py:636
msgid ""
"Returns true if `x` is less than `y` using the comparison specified in "
"`type`.\n"
"Possible values of `type` are \"int\" (integer), \"float\" (floating point), "
"\"text\"\n"
"(case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" "
"(automatically\n"
"determine the type of arguments provided), with \"auto\" used as the "
"default\n"
"comparison method if `type` is not specified.  The \"auto\" type will use "
"the\n"
"first type that applies to both arguments in the following order of "
"preference:\n"
"\"int\", \"float\" and \"text\"."
msgstr ""
"Returnerar sant om `x` är mindre än `y` enligt jämförelsen som anges i "
"`type`.\n"
"Möjliga värden för `type` är \"int\" (heltal), \"float\" (flyttal), "
"\"text\"\n"
"(skiftlägeskänslig text), \"nocase\" (text utan hänsyn till skiftläge) och "
"\"auto\" (automatisk\n"
"bestämning av argumentens typ). \"auto\" används som förvald\n"
"jämförelsemetod om `type` inte anges. Typen \"auto\" använder den\n"
"första typ som passar båda argumenten i följande prioritetsordning:\n"
"\"int\", \"float\" och \"text\"."

#: picard/script/functions.py:650
msgid "$lte(x,y[,type])"
msgstr "$lte(x,y[,type])"

#: picard/script/functions.py:652
msgid ""
"Returns true if `x` is less than or equal to `y` using the comparison "
"specified in `type`.\n"
"Possible values of `type` are \"int\" (integer), \"float\" (floating point), "
"\"text\"\n"
"(case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" "
"(automatically\n"
"determine the type of arguments provided), with \"auto\" used as the "
"default\n"
"comparison method if `type` is not specified.  The \"auto\" type will use "
"the\n"
"first type that applies to both arguments in the following order of "
"preference:\n"
"\"int\", \"float\" and \"text\"."
msgstr ""
"Returnerar sant om `x` är mindre än eller lika med `y` enligt jämförelsen "
"som anges i `type`.\n"
"Möjliga värden för `type` är \"int\" (heltal), \"float\" (flyttal), "
"\"text\"\n"
"(skiftlägeskänslig text), \"nocase\" (text utan hänsyn till skiftläge) och "
"\"auto\" (automatisk\n"
"bestämning av argumentens typ). \"auto\" används som förvald\n"
"jämförelsemetod om `type` inte anges. Typen \"auto\" använder den\n"
"första typ som passar båda argumenten i följande prioritetsordning:\n"
"\"int\", \"float\" och \"text\"."

#: picard/script/functions.py:666
msgid "$gt(x,y[,type])"
msgstr "$gt(x,y[,type])"

#: picard/script/functions.py:668
msgid ""
"Returns true if `x` is greater than `y` using the comparison specified in "
"`type`.\n"
"Possible values of `type` are \"int\" (integer), \"float\" (floating point), "
"\"text\"\n"
"(case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" "
"(automatically\n"
"determine the type of arguments provided), with \"auto\" used as the "
"default\n"
"comparison method if `type` is not specified.  The \"auto\" type will use "
"the\n"
"first type that applies to both arguments in the following order of "
"preference:\n"
"\"int\", \"float\" and \"text\"."
msgstr ""
"Returnerar sant om `x` är större än `y` enligt jämförelsen som anges i "
"`type`.\n"
"Möjliga värden för `type` är \"int\" (heltal), \"float\" (flyttal), "
"\"text\"\n"
"(skiftlägeskänslig text), \"nocase\" (text utan hänsyn till skiftläge) och "
"\"auto\" (automatisk\n"
"bestämning av argumentens typ). \"auto\" används som förvald\n"
"jämförelsemetod om `type` inte anges. Typen \"auto\" använder den\n"
"första typ som passar båda argumenten i följande prioritetsordning:\n"
"\"int\", \"float\" och \"text\"."

#: picard/script/functions.py:682
msgid "$gte(x,y[,type])"
msgstr "$gte(x,y[,type])"

#: picard/script/functions.py:684
msgid ""
"Returns true if `x` is greater than or equal to `y` using the comparison "
"specified in `type`.\n"
"Possible values of `type` are \"int\" (integer), \"float\" (floating point), "
"\"text\"\n"
"(case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" "
"(automatically\n"
"determine the type of arguments provided), with \"auto\" used as the "
"default\n"
"comparison method if `type` is not specified.  The \"auto\" type will use "
"the\n"
"first type that applies to both arguments in the following order of "
"preference:\n"
"\"int\", \"float\" and \"text\"."
msgstr ""
"Returnerar sant om `x` är större än eller lika med `y` enligt jämförelsen "
"som anges i `type`.\n"
"Möjliga värden för `type` är \"int\" (heltal), \"float\" (flyttal), "
"\"text\"\n"
"(skiftlägeskänslig text), \"nocase\" (text utan hänsyn till skiftläge) och "
"\"auto\" (automatisk\n"
"bestämning av argumentens typ). \"auto\" används som förvald\n"
"jämförelsemetod om `type` inte anges. Typen \"auto\" använder den\n"
"första typ som passar båda argumenten i följande prioritetsordning:\n"
"\"int\", \"float\" och \"text\"."

#: picard/script/functions.py:698
msgid "$len(text)"
msgstr "$len(text)"

#: picard/script/functions.py:699
msgid "Returns the number of characters in `text`."
msgstr "Returnerar antalet tecken i `text`."

#: picard/script/functions.py:707
msgid "$lenmulti(name[,separator=; ])"
msgstr "$lenmulti(name[,separator=; ])"

#: picard/script/functions.py:709
msgid ""
"Returns the number of elements in the multi-value tag `name`. A literal "
"value\n"
"    representing a multi-value can be substituted for `name`, using the\n"
"    `separator` (or \"; \" if not passed) to coerce the value into a proper\n"
"    multi-valued tag.\n"
"\n"
"Example:\n"
"\n"
"    $lenmulti(One; Two; Three) = 3\n"
msgstr ""
"Returnerar antalet element i flervärdestaggen `name`. Ett bokstavligt värde\n"
"    som representerar ett flervärde kan användas i stället för `name`;\n"
"    `separator` (eller \"; \" om den inte anges) används för att konvertera "
"värdet till en korrekt\n"
"    flervärdestagg.\n"
"\n"
"Exempel:\n"
"\n"
"    $lenmulti(One; Two; Three) = 3\n"

#: picard/script/functions.py:725
msgid "$performer([pattern[,join=, ]])"
msgstr "$performer([pattern[,join=, ]])"

#: picard/script/functions.py:727
msgid ""
"Returns the performers where the performance type (e.g. \"vocal\") matches "
"`pattern`, joined by `join`.\n"
"You can specify a regular expression in the format `/pattern/flags`. `flags` "
"are optional. Currently\n"
"the only supported flag is \"i\" (ignore case). For example `$performer(/"
"^guitars?$/i)` matches the\n"
"performance type \"guitar\" or \"Guitars\", but not e.g. \"bass guitar\".\n"
"\n"
"_Since Picard 0.10_"
msgstr ""
"Returnerar utövare vars utövartyp (t.ex. \"vocal\") matchar `pattern`, "
"sammanfogade med `join`.\n"
"Du kan ange ett reguljärt uttryck i formatet `/pattern/flags`. `flags` är "
"valfritt. För närvarande\n"
"stöds endast flaggan \"i\" (ignorera skiftläge). Exempelvis matchar "
"`$performer(/^guitars?$/i)`\n"
"utövartypen \"guitar\" eller \"Guitars\", men inte exempelvis \"bass "
"guitar\".\n"
"\n"
"_Sedan Picard 0.10_"

#: picard/script/functions.py:752
msgid ""
"Returns the number of matched tracks within a release.\n"
"    **Only works in File Naming scripts.**\n"
"\n"
"_Since Picard 0.12_"
msgstr ""
"Returnerar antalet matchade spår i en utgåva.\n"
"    **Fungerar endast i filnamnsskript.**\n"
"\n"
"_Sedan Picard 0.12_"

#: picard/script/functions.py:768
msgid ""
"Returns true if every track in the album is matched to a single file.\n"
"**Only works in File Naming scripts.**"
msgstr ""
"Returnerar sant om varje spår i albumet är matchat mot en enda fil.\n"
"**Fungerar endast i filnamnsskript.**"

#: picard/script/functions.py:787
msgid "$firstalphachar(text[,nonalpha=#])"
msgstr "$firstalphachar(text[,nonalpha=#])"

#: picard/script/functions.py:789
msgid ""
"Returns the first character of `text`.\n"
"If `text` does not begin with an alphabetic character, then `nonalpha` is "
"returned instead. If `nonalpha` is not\n"
"specified, the default value \"#\" will be used.\n"
"\n"
"_Since Picard 0.12_"
msgstr ""
"Returnerar det första tecknet i `text`.\n"
"Om `text` inte börjar med en bokstav returneras `nonalpha` i stället. Om "
"`nonalpha` inte\n"
"anges används det förvalda värdet \"#\".\n"
"\n"
"_Sedan Picard 0.12_"

#: picard/script/functions.py:807
msgid "$initials(text)"
msgstr "$initials(text)"

#: picard/script/functions.py:809
msgid ""
"Returns the first character of each word in `text`, if it is an alphabetic "
"character.\n"
"\n"
"_Since Picard 0.12_"
msgstr ""
"Returnerar det första tecknet i varje ord i `text` om det är en bokstav.\n"
"\n"
"_Sedan Picard 0.12_"

#: picard/script/functions.py:819
msgid "$firstwords(text,length)"
msgstr "$firstwords(text,length)"

#: picard/script/functions.py:821
msgid ""
"Like `$truncate()` except that it will only return the complete words from "
"`text` which fit within `length` characters.\n"
"\n"
"_Since Picard 0.12_"
msgstr ""
"Liknar `$truncate()`, men returnerar endast hela ord från `text` som ryms "
"inom `length` tecken.\n"
"\n"
"_Sedan Picard 0.12_"

#: picard/script/functions.py:843
msgid "$startswith(text,prefix)"
msgstr "$startswith(text,prefix)"

#: picard/script/functions.py:845
msgid ""
"Returns true if `text` starts with `prefix`.\n"
"\n"
"_Since Picard 1.4_"
msgstr ""
"Returnerar sant om `text` börjar med `prefix`.\n"
"\n"
"_Sedan Picard 1.4_"

#: picard/script/functions.py:857
msgid "$endswith(text,suffix)"
msgstr "$endswith(text,suffix)"

#: picard/script/functions.py:859
msgid ""
"Returns true if `text` ends with `suffix`.\n"
"\n"
"_Since Picard 1.4_"
msgstr ""
"Returnerar sant om `text` slutar med `suffix`.\n"
"\n"
"_Sedan Picard 1.4_"

#: picard/script/functions.py:871
msgid "$truncate(text,length)"
msgstr "$truncate(text,length)"

#: picard/script/functions.py:873
msgid ""
"Truncate `text` to `length`.\n"
"\n"
"_Since Picard 0.12_"
msgstr ""
"Förkortar `text` till `length`.\n"
"\n"
"_Sedan Picard 0.12_"

#: picard/script/functions.py:888
msgid "$swapprefix(text,prefix1,prefix2,…)"
msgstr "$swapprefix(text,prefix1,prefix2,…)"

#: picard/script/functions.py:890
msgid ""
"Moves the specified prefixes from the beginning to the end of `text`. "
"Multiple\n"
"prefixes can be specified as separate parameters. If no prefix is specified "
"'A'\n"
"and 'The' are used by default.\n"
"\n"
"Example:\n"
"\n"
"    $swapprefix(%albumartist%,A,An,The,La,Le,Les,Un,Une)\n"
"\n"
"_Since Picard 1.3, previously as a plugin since Picard 0.13_"
msgstr ""
"Flyttar angivna prefix från början till slutet av `text`. Flera\n"
"prefix kan anges som separata parametrar. Om inget prefix anges används 'A'\n"
"och 'The' som standard.\n"
"\n"
"Exempel:\n"
"\n"
"    $swapprefix(%albumartist%,A,An,The,La,Le,Les,Un,Une)\n"
"\n"
"_Sedan Picard 1.3, tidigare som insticksmodul sedan Picard 0.13_"

#: picard/script/functions.py:912
msgid "$delprefix(text,prefix1,prefix2,…)"
msgstr "$delprefix(text,prefix1,prefix2,…)"

#: picard/script/functions.py:914
msgid ""
"Deletes the specified prefixes from the beginning of `text`. Multiple\n"
"prefixes can be specified as separate parameters.  If no prefix is specified "
"'A'\n"
"and 'The' are used by default.\n"
"\n"
"Example:\n"
"\n"
"    $delprefix(%albumartist%,A,An,The,La,Le,Les,Un,Une)\n"
"\n"
"_Since Picard 1.3_"
msgstr ""
"Tar bort angivna prefix från början av `text`. Flera\n"
"prefix kan anges som separata parametrar. Om inget prefix anges används 'A'\n"
"och 'The' som standard.\n"
"\n"
"Exempel:\n"
"\n"
"    $delprefix(%albumartist%,A,An,The,La,Le,Les,Un,Une)\n"
"\n"
"_Sedan Picard 1.3_"

#: picard/script/functions.py:952
msgid "$eq_any(x,a1,a2,…)"
msgstr "$eq_any(x,a1,a2,…)"

#: picard/script/functions.py:954
msgid ""
"Returns true if `x` equals `a1` or `a2` or …\n"
"Functionally equivalent to `$or($eq(x,a1),$eq(x,a2),…)`.\n"
"Functionally equivalent to the eq2 plugin."
msgstr ""
"Returnerar sant om `x` är lika med `a1`, `a2` eller …\n"
"Funktionellt motsvarande `$or($eq(x,a1),$eq(x,a2),…)`.\n"
"Funktionellt motsvarande insticksmodulen eq2."

#: picard/script/functions.py:966
msgid "$ne_all(x,a1,a2,…)"
msgstr "$ne_all(x,a1,a2,…)"

#: picard/script/functions.py:968
msgid ""
"Returns true if `x` does not equal `a1` and `a2` and …\n"
"Functionally equivalent to `$and($ne(x,a1),$ne(x,a2),…)`.\n"
"Functionally equivalent to the ne2 plugin."
msgstr ""
"Returnerar sant om `x` inte är lika med `a1`, `a2` och …\n"
"Funktionellt motsvarande `$and($ne(x,a1),$ne(x,a2),…)`.\n"
"Funktionellt motsvarande insticksmodulen ne2."

#: picard/script/functions.py:980
msgid "$eq_all(x,a1,a2,…)"
msgstr "$eq_all(x,a1,a2,…)"

#: picard/script/functions.py:982
msgid ""
"Returns true if `x` equals `a1` and `a2` and …\n"
"Functionally equivalent to `$and($eq(x,a1),$eq(x,a2),…)`.\n"
"\n"
"Example:\n"
"\n"
"    $if($eq_all(%albumartist%,%artist%,Justin Bieber),$set(engineer,Meat "
"Loaf))\n"
msgstr ""
"Returnerar sant om `x` är lika med `a1`, `a2` och …\n"
"Funktionellt motsvarande `$and($eq(x,a1),$eq(x,a2),…)`.\n"
"\n"
"Exempel:\n"
"\n"
"    $if($eq_all(%albumartist%,%artist%,Justin Bieber),$set(engineer,Meat "
"Loaf))\n"

#: picard/script/functions.py:1000
msgid "$ne_any(x,a1,a2,…)"
msgstr "$ne_any(x,a1,a2,…)"

#: picard/script/functions.py:1002
#, python-format
msgid ""
"Returns true if `x` does not equal `a1` or `a2` or …\n"
"Functionally equivalent to `$or($ne(x,a1),$ne(x,a2),…)`.\n"
"\n"
"Example:\n"
"\n"
"    $if($ne_any(%albumartist%,%trackartist%,%composer%),$set(lyricist,"
"%composer%))\n"
msgstr ""
"Returnerar sant om `x` inte är lika med `a1`, `a2` eller …\n"
"Funktionellt motsvarande `$or($ne(x,a1),$ne(x,a2),…)`.\n"
"\n"
"Exempel:\n"
"\n"
"    $if($ne_any(%albumartist%,%trackartist%,%composer%),$set(lyricist,"
"%composer%))\n"

#: picard/script/functions.py:1016
msgid "$title(text)"
msgstr "$title(text)"

#: picard/script/functions.py:1018
msgid ""
"Returns `text` in title case (first character in every word capitalized).\n"
"\n"
"Example:\n"
"\n"
"    $set(album,$title(%album%))\n"
"_Since Picard 2.1_"
msgstr ""
"Returnerar `text` med stor bokstav i början av varje ord.\n"
"\n"
"Exempel:\n"
"\n"
"    $set(album,$title(%album%))\n"
"_Sedan Picard 2.1_"

#: picard/script/functions.py:1032
msgid ""
"Returns true, if the file processed is an audio file.\n"
"\n"
"_Since Picard 2.2_"
msgstr ""
"Returnerar sant om filen som behandlas är en ljudfil.\n"
"\n"
"_Sedan Picard 2.2_"

#: picard/script/functions.py:1046
msgid ""
"Returns true, if the file processed is a video file.\n"
"\n"
"_Since Picard 2.2_"
msgstr ""
"Returnerar sant om filen som behandlas är en videofil.\n"
"\n"
"_Sedan Picard 2.2_"

#: picard/script/functions.py:1059
msgid "$find(haystack,needle)"
msgstr "$find(haystack,needle)"

#: picard/script/functions.py:1061
msgid ""
"Finds the location of one string within another.\n"
"    Returns the index of the first occurrence of `needle` in `haystack`, or "
"\"\" if `needle` was not found.\n"
"\n"
"_Since Picard 2.3_\n"
"\n"
"Note that prior to Picard 2.3.2 `$find` returned \"-1\" if `needle` was not "
"found."
msgstr ""
"Söker efter en sträng i en annan.\n"
"    Returnerar indexet för den första förekomsten av `needle` i `haystack`, "
"eller \"\" om `needle` inte hittades.\n"
"\n"
"_Sedan Picard 2.3_\n"
"\n"
"Observera att `$find` före Picard 2.3.2 returnerade \"-1\" om `needle` inte "
"hittades."

#: picard/script/functions.py:1077
msgid "$reverse(text)"
msgstr "$reverse(text)"

#: picard/script/functions.py:1078
msgid "Returns `text` in reverse order."
msgstr "Returnerar `text` i omvänd ordning."

#: picard/script/functions.py:1085
msgid "$substr(text,start[,end])"
msgstr "$substr(text,start[,end])"

#: picard/script/functions.py:1087
msgid ""
"Returns the substring beginning with the character at the `start` index, up "
"to\n"
"    (but not including) the character at the `end` index. Indexes are\n"
"    zero-based. Negative numbers will be counted back from the end of the\n"
"    string. If the `start` or `end` indexes are left blank, they will "
"default to\n"
"    the start and end of the string respectively."
msgstr ""
"Returnerar delsträngen som börjar med tecknet vid index `start` och "
"fortsätter till\n"
"    (men inte inkluderar) tecknet vid index `end`. Index är\n"
"    nollbaserade. Negativa tal räknas bakåt från strängens slut.\n"
"    Om `start` eller `end` lämnas tomt används början respektive slutet av "
"strängen."

#: picard/script/functions.py:1108
msgid "$getmulti(name,index[,separator=; ])"
msgstr "$getmulti(name,index[,separator=; ])"

#: picard/script/functions.py:1110
msgid ""
"Gets the element at `index` from the multi-value tag `name`. A literal "
"value\n"
"    representing a multi-value can be substituted for `name`, using the\n"
"    separator (or \"; \" if not passed) to coerce the value into a proper\n"
"    multi-valued tag."
msgstr ""
"Hämtar elementet vid `index` från flervärdestaggen `name`. Ett bokstavligt "
"värde\n"
"    som representerar ett flervärde kan användas i stället för `name`;\n"
"    avgränsaren (eller \"; \" om den inte anges) används för att konvertera "
"värdet till en korrekt\n"
"    flervärdestagg."

#: picard/script/functions.py:1129
msgid "$foreach(name,code[,separator=; ])"
msgstr "$foreach(name,code[,separator=; ])"

#: picard/script/functions.py:1131
msgid ""
"Iterates over each element found in the multi-value tag `name`, executing\n"
"    `code`. For each loop, the element value is first stored in the tag\n"
"    `_loop_value` and the count is stored in the tag `_loop_count`. This "
"allows\n"
"    the element or count value to be accessed within the `code` script. A\n"
"    literal value representing a multi-value can be substituted for `name`,\n"
"    using the separator (or \"; \" if not passed) to coerce the value into "
"a\n"
"    proper multi-valued tag."
msgstr ""
"Går igenom varje element i flervärdestaggen `name` och kör\n"
"    `code`. Vid varje varv lagras elementets värde först i taggen\n"
"    `_loop_value` och räknaren i taggen `_loop_count`. Därmed kan\n"
"    elementets värde eller räknaren användas i skriptet `code`. Ett\n"
"    bokstavligt flervärde kan användas i stället för `name`;\n"
"    avgränsaren (eller \"; \" om den inte anges) konverterar värdet till en "
"korrekt\n"
"    flervärdestagg."

#: picard/script/functions.py:1153
msgid "$while(condition,code)"
msgstr "$while(condition,code)"

#: picard/script/functions.py:1155
msgid ""
"Standard 'while' loop. Executes `code` repeatedly until `condition` no "
"longer\n"
"    evaluates to `True`. For each loop, the count is stored in the tag\n"
"    `_loop_count`. This allows the count value to be accessed within the "
"`code`\n"
"    script. The function limits the maximum number of iterations to 1000 as "
"a\n"
"    safeguard against accidentally creating an infinite loop."
msgstr ""
"En vanlig while-loop. Kör `code` upprepade gånger tills `condition` inte "
"längre\n"
"    utvärderas till `True`. Vid varje varv lagras räknaren i taggen\n"
"    `_loop_count`, så att värdet kan användas i skriptet `code`.\n"
"    Funktionen begränsar antalet iterationer till 1 000 för att skydda mot\n"
"    oavsiktliga oändliga loopar."

#: picard/script/functions.py:1176
msgid "$map(name,code[,separator=; ])"
msgstr "$map(name,code[,separator=; ])"

#: picard/script/functions.py:1178
msgid ""
"Iterates over each element found in the multi-value tag `name` and updates "
"the\n"
"    value of the element to the value returned by `code`, returning the "
"updated\n"
"    multi-value tag. For each loop, the element value is first stored in the "
"tag\n"
"    `_loop_value` and the count is stored in the tag `_loop_count`. This "
"allows\n"
"    the element or count value to be accessed within the `code` script.\n"
"\n"
"Empty elements are automatically removed.\n"
"\n"
"Example:\n"
"\n"
"    $map(First:A; Second:B,$upper(%_loop_count%=%_loop_value%))\n"
"\n"
"Result: 1=FIRST:A; 2=SECOND:B\n"
msgstr ""
"Går igenom varje element i flervärdestaggen `name`, uppdaterar\n"
"    elementets värde till värdet som returneras av `code` och returnerar den "
"uppdaterade\n"
"    flervärdestaggen. Vid varje varv lagras elementets värde först i taggen\n"
"    `_loop_value` och räknaren i taggen `_loop_count`, så att de kan "
"användas i skriptet `code`.\n"
"\n"
"Tomma element tas bort automatiskt.\n"
"\n"
"Exempel:\n"
"\n"
"    $map(First:A; Second:B,$upper(%_loop_count%=%_loop_value%))\n"
"\n"
"Resultat: 1=FIRST:A; 2=SECOND:B\n"

#: picard/script/functions.py:1208
msgid "$join(name,text[,separator=; ])"
msgstr "$join(name,text[,separator=; ])"

#: picard/script/functions.py:1210
msgid ""
"Joins all elements in `name`, placing `text` between each element, and "
"returns the result as a string."
msgstr ""
"Sammanfogar alla element i `name`, placerar `text` mellan elementen och "
"returnerar resultatet som en sträng."

#: picard/script/functions.py:1221
msgid "$slice(name,start,end[,separator=; ])"
msgstr "$slice(name,start,end[,separator=; ])"

#: picard/script/functions.py:1223
msgid ""
"Returns a multi-value variable containing the elements between the `start` "
"and\n"
"    `end` indexes from the multi-value tag `name`. A literal value "
"representing\n"
"    a multi-value can be substituted for `name`, using the separator (or \"; "
"\" if\n"
"    not passed) to coerce the value into a proper multi-valued tag. Indexes "
"are\n"
"    zero based. Negative numbers will be counted back from the end of the "
"list.\n"
"    If the `start` or `end` indexes are left blank, they will default to "
"the\n"
"    start and end of the list respectively.\n"
"\n"
"The following example will create a multi-value variable with all artists\n"
"    in `%artists%` except the first, which can be used to create a \"feat.\" "
"list.\n"
"\n"
"Examples:\n"
"\n"
"    $setmulti(supporting_artists,$slice(%artists%,1))\n"
"    $setmulti(supporting_artists,$slice(%artists%,1,-1))\n"
msgstr ""
"Returnerar en flervärdesvariabel med elementen mellan indexen `start` och\n"
"    `end` i flervärdestaggen `name`. Ett bokstavligt flervärde kan användas\n"
"    i stället för `name`; avgränsaren (eller \"; \" om den inte anges) "
"konverterar\n"
"    värdet till en korrekt flervärdestagg. Index är nollbaserade. Negativa "
"tal\n"
"    räknas bakåt från listans slut. Om `start` eller `end` lämnas tomt "
"används\n"
"    listans början respektive slut.\n"
"\n"
"Följande exempel skapar en flervärdesvariabel med alla artister\n"
"    i `%artists%` utom den första, vilket kan användas för en lista med "
"\"feat.\".\n"
"\n"
"Exempel:\n"
"\n"
"    $setmulti(supporting_artists,$slice(%artists%,1))\n"
"    $setmulti(supporting_artists,$slice(%artists%,1,-1))\n"

#: picard/script/functions.py:1255
#, python-format
msgid "$datetime([format=%Y-%m-%d %H:%M:%S])"
msgstr "$datetime([format=%Y-%m-%d %H:%M:%S])"

#: picard/script/functions.py:1257
#, python-format
msgid ""
"Returns the current date and time in the specified `format`, which is based "
"on\n"
"    the standard Python `strftime` [format codes](https://strftime.org/). If "
"no\n"
"    `format` is specified the date/time will be returned in the form\n"
"    `2020-02-05 14:26:32`.\n"
"Note: Platform-specific formatting codes should be avoided to help ensure "
"the\n"
"    portability of scripts across the different platforms.  These codes "
"include:\n"
"    remove zero-padding (e.g. `%-d` and `%-m` on Linux or macOS, and their\n"
"    equivalent `%#d` and `%#m` on Windows); element length specifiers (e.g.\n"
"    `%3Y`); and hanging '%' at the end of the format string."
msgstr ""
"Returnerar aktuellt datum och aktuell tid i angivet `format`, baserat på "
"Pythons vanliga\n"
"    `strftime`-[formatkoder](https://strftime.org/). Om inget `format` "
"anges\n"
"    returneras datum och tid som `2020-02-05 14:26:32`.\n"
"Observera: Plattformsspecifika formatkoder bör undvikas för att skript ska "
"vara\n"
"    portabla mellan olika plattformar. Dessa koder omfattar borttagning av\n"
"    inledande nollor (t.ex. `%-d` och `%-m` i Linux eller macOS och "
"motsvarande\n"
"    `%#d` och `%#m` i Windows), längdangivelser (t.ex. `%3Y`) och ett "
"avslutande\n"
"    '%' i slutet av formatsträngen."

#: picard/script/functions.py:1281
msgid "$sortmulti(name[,separator=; ])"
msgstr "$sortmulti(name[,separator=; ])"

#: picard/script/functions.py:1283
msgid ""
"Returns a copy of the multi-value tag `name` with the elements sorted in "
"ascending order.\n"
"\n"
"Example:\n"
"\n"
"    $sortmulti(B; A; C)\n"
"\n"
"Result: A; B; C\n"
msgstr ""
"Returnerar en kopia av flervärdestaggen `name` med elementen sorterade i "
"stigande ordning.\n"
"\n"
"Exempel:\n"
"\n"
"    $sortmulti(B; A; C)\n"
"\n"
"Resultat: A; B; C\n"

#: picard/script/functions.py:1300
msgid "$reversemulti(name[,separator=; ])"
msgstr "$reversemulti(name[,separator=; ])"

#: picard/script/functions.py:1302
msgid ""
"Returns a copy of the multi-value tag `name` with the elements in reverse "
"order.\n"
"    This can be used in conjunction with the `$sortmulti` function to sort "
"in\n"
"    descending order.\n"
"\n"
"Example:\n"
"\n"
"    $reversemulti($sortmulti(B; A; C))\n"
"\n"
"Result: C; B; A\n"
msgstr ""
"Returnerar en kopia av flervärdestaggen `name` med elementen i omvänd "
"ordning.\n"
"    Funktionen kan användas tillsammans med `$sortmulti` för att sortera i\n"
"    fallande ordning.\n"
"\n"
"Exempel:\n"
"\n"
"    $reversemulti($sortmulti(B; A; C))\n"
"\n"
"Resultat: C; B; A\n"

#: picard/script/functions.py:1321
msgid "$unique(name[,case_sensitive[,separator=; ]])"
msgstr "$unique(name[,case_sensitive[,separator=; ]])"

#: picard/script/functions.py:1323
#, python-format
msgid ""
"Returns a copy of the multi-value tag `name` with no duplicate elements.\n"
"    By default, a case-insensitive comparison of the elements is performed.\n"
"\n"
"Example 1:\n"
"\n"
"    $setmulti(foo,a; A; B; b; cd; Cd; cD; CD; a; A; b)\n"
"    $unique(%foo%)\n"
"\n"
"Result: A; CD; b\n"
"\n"
"Example 2:\n"
"\n"
"    $setmulti(foo,a; A; B; b; a; b; A; B, cd)\n"
"    $unique(%foo%,True)\n"
"\n"
"Result: A; B; a; b; cd\n"
msgstr ""
"Returnerar en kopia av flervärdestaggen `name` utan dubbletter.\n"
"    Som standard jämförs elementen utan hänsyn till skiftläge.\n"
"\n"
"Exempel 1:\n"
"\n"
"    $setmulti(foo,a; A; B; b; cd; Cd; cD; CD; a; A; b)\n"
"    $unique(%foo%)\n"
"\n"
"Resultat: A; CD; b\n"
"\n"
"Exempel 2:\n"
"\n"
"    $setmulti(foo,a; A; B; b; a; b; A; B, cd)\n"
"    $unique(%foo%,True)\n"
"\n"
"Resultat: A; B; a; b; cd\n"

#: picard/script/functions.py:1350
msgid "$countryname(country_code[,translate])"
msgstr "$countryname(country_code[,translate])"

#: picard/script/functions.py:1352
msgid ""
"Returns the name of the country for the specified country code. If the "
"country code is invalid an empty string will be returned.\n"
"If `translate` is not blank, the output will be translated into the current "
"locale language.\n"
msgstr ""
"Returnerar landets namn för den angivna landskoden. Om landskoden är ogiltig "
"returneras en tom sträng.\n"
"Om `translate` inte är tomt översätts resultatet till det aktuella språkets "
"språkvariant.\n"

#: picard/script/functions.py:1390
msgid "$year(date[,date_order=ymd])"
msgstr "$year(date[,date_order=ymd])"

#: picard/script/functions.py:1392
msgid ""
"Returns the year portion of the specified date.  The default order is "
"\"ymd\".  This can be changed by specifying\n"
"either \"dmy\" or \"mdy\".  If the date is invalid an empty string will be "
"returned.\n"
"\n"
"_Since Picard 2.7_"
msgstr ""
"Returnerar årsdelen av det angivna datumet. Förvald ordning är \"ymd\". Den "
"kan ändras genom att ange\n"
"antingen \"dmy\" eller \"mdy\". Om datumet är ogiltigt returneras en tom "
"sträng.\n"
"\n"
"_Sedan Picard 2.7_"

#: picard/script/functions.py:1403
msgid "$month(date[,date_order=ymd])"
msgstr "$month(date[,date_order=ymd])"

#: picard/script/functions.py:1405
msgid ""
"Returns the month portion of the specified date.  The default order is "
"\"ymd\".  This can be changed by specifying\n"
"either \"dmy\" or \"mdy\".  If the date is invalid an empty string will be "
"returned.\n"
"\n"
"_Since Picard 2.7_"
msgstr ""
"Returnerar månadsdelen av det angivna datumet. Förvald ordning är \"ymd\". "
"Den kan ändras genom att ange\n"
"antingen \"dmy\" eller \"mdy\". Om datumet är ogiltigt returneras en tom "
"sträng.\n"
"\n"
"_Sedan Picard 2.7_"

#: picard/script/functions.py:1416
msgid "$day(date[,date_order=ymd])"
msgstr "$day(date[,date_order=ymd])"

#: picard/script/functions.py:1418
msgid ""
"Returns the day portion of the specified date.  The default order is "
"\"ymd\".  This can be changed by specifying\n"
"either \"dmy\" or \"mdy\".  If the date is invalid an empty string will be "
"returned.\n"
"\n"
"_Since Picard 2.7_"
msgstr ""
"Returnerar dagsdelen av det angivna datumet. Förvald ordning är \"ymd\". Den "
"kan ändras genom att ange\n"
"antingen \"dmy\" eller \"mdy\". Om datumet är ogiltigt returneras en tom "
"sträng.\n"
"\n"
"_Sedan Picard 2.7_"

#: picard/script/functions.py:1429
#, python-format
msgid "$dateformat(date[,format=%Y-%m-%d[,date_order=ymd]])"
msgstr "$dateformat(date[,format=%Y-%m-%d[,date_order=ymd]])"

#: picard/script/functions.py:1431
#, python-format
msgid ""
"Returns the input date in the specified `format`, which is based on the "
"standard\n"
"    Python `strftime` [format codes](https://strftime.org/). If no `format` "
"is\n"
"    specified the date will be returned in the form `2020-02-05`.  If the "
"date or\n"
"    format are invalid an empty string will be returned.\n"
"\n"
"    The default order for the input date is \"ymd\".  This can be changed by "
"specifying\n"
"    either \"dmy\" or \"mdy\".\n"
"Note: Platform-specific formatting codes should be avoided to help ensure "
"the\n"
"    portability of scripts across the different platforms.  These codes "
"include:\n"
"    remove zero-padding (e.g. `%-d` and `%-m` on Linux or macOS, and their\n"
"    equivalent `%#d` and `%#m` on Windows); element length specifiers (e.g.\n"
"    `%3Y`); and hanging '%' at the end of the format string.\n"
"\n"
"_Since Picard 2.7_"
msgstr ""
"Returnerar inmatningsdatumet i angivet `format`, baserat på Pythons vanliga\n"
"    `strftime`-[formatkoder](https://strftime.org/). Om inget `format` "
"anges\n"
"    returneras datumet som `2020-02-05`. Om datumet eller formatet\n"
"    är ogiltigt returneras en tom sträng.\n"
"\n"
"    Förvald ordning för inmatningsdatumet är \"ymd\". Den kan ändras genom "
"att ange\n"
"    antingen \"dmy\" eller \"mdy\".\n"
"Observera: Plattformsspecifika formatkoder bör undvikas för att skript ska "
"vara\n"
"    portabla mellan olika plattformar. Dessa koder omfattar borttagning av\n"
"    inledande nollor (t.ex. `%-d` och `%-m` i Linux eller macOS och "
"motsvarande\n"
"    `%#d` och `%#m` i Windows), längdangivelser (t.ex. `%3Y`) och ett "
"avslutande\n"
"    '%' i slutet av formatsträngen.\n"
"\n"
"_Sedan Picard 2.7_"

#: picard/script/functions.py:1464
msgid "$is_multi(name)"
msgstr "$is_multi(name)"

#: picard/script/functions.py:1466
msgid ""
"Returns '1' if the argument is a multi-value tag and there are more than one "
"elements, otherwise an empty string.\n"
"\n"
"Example:\n"
"\n"
"    $is_multi(%artists%)\n"
"\n"
"Result: 1 if there is more than one artist, otherwise \"\".\n"
"\n"
"_Since Picard 2.7_"
msgstr ""
"Returnerar '1' om argumentet är en flervärdestagg med fler än ett element, "
"annars en tom sträng.\n"
"\n"
"Exempel:\n"
"\n"
"    $is_multi(%artists%)\n"
"\n"
"Resultat: 1 om det finns fler än en artist, annars \"\".\n"
"\n"
"_Sedan Picard 2.7_"

#: picard/script/functions.py:1484
msgid "$cleanmulti(name)"
msgstr "$cleanmulti(name)"

#: picard/script/functions.py:1486
msgid ""
"Removes all empty string elements from the multi-value variable.\n"
"\n"
"Example:\n"
"\n"
"    $setmulti(test,one; ; two; three)\n"
"    $cleanmulti(test)\n"
"\n"
"Result: Sets the value of 'test' to [\"one\", \"two\", \"three\"].\n"
"\n"
"_Since Picard 2.8_"
msgstr ""
"Tar bort alla element med tomma strängar från flervärdesvariabeln.\n"
"\n"
"Exempel:\n"
"\n"
"    $setmulti(test,one; ; two; three)\n"
"    $cleanmulti(test)\n"
"\n"
"Resultat: Ställer in värdet för 'test' på [\"one\", \"two\", \"three\"].\n"
"\n"
"_Sedan Picard 2.8_"

#: picard/script/functions.py:1555
msgid "$min(type,x,…)"
msgstr "$min(type,x,…)"

#: picard/script/functions.py:1557
msgid ""
"Returns the minimum value using the comparison specified in `type`.\n"
"\n"
"Possible values of `type` are \"int\" (integer), \"float\" (floating point), "
"\"text\"\n"
"(case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" "
"(automatically\n"
"determine the type of arguments provided), with \"auto\" used as the "
"default\n"
"comparison method if `type` is not specified.  The \"auto\" type will use "
"the\n"
"first type that applies to both arguments in the following order of "
"preference:\n"
"\"int\", \"float\" and \"text\".\n"
"\n"
"Can be used with an arbitrary number of arguments.  Multi-value arguments\n"
"will be expanded automatically.\n"
"\n"
"_Since Picard 2.9_"
msgstr ""
"Returnerar det minsta värdet enligt jämförelsen som anges i `type`.\n"
"\n"
"Möjliga värden för `type` är \"int\" (heltal), \"float\" (flyttal), "
"\"text\"\n"
"(skiftlägeskänslig text), \"nocase\" (text utan hänsyn till skiftläge) och "
"\"auto\" (automatisk\n"
"bestämning av argumentens typ). \"auto\" används som förvald jämförelsemetod "
"om `type` inte anges. Typen \"auto\" använder den\n"
"första typ som passar båda argumenten i följande prioritetsordning:\n"
"\"int\", \"float\" och \"text\".\n"
"\n"
"Kan användas med valfritt antal argument. Flervärdesargument\n"
"expanderas automatiskt.\n"
"\n"
"_Sedan Picard 2.9_"

#: picard/script/functions.py:1577
msgid "$max(type,x,…)"
msgstr "$max(type,x,…)"

#: picard/script/functions.py:1579
msgid ""
"Returns the maximum value using the comparison specified in `type`.\n"
"\n"
"Possible values of `type` are \"int\" (integer), \"float\" (floating point), "
"\"text\"\n"
"(case-sensitive text), \"nocase\" (case-insensitive text) and \"auto\" "
"(automatically\n"
"determine the type of arguments provided), with \"auto\" used as the "
"default\n"
"comparison method if `type` is not specified.  The \"auto\" type will use "
"the\n"
"first type that applies to both arguments in the following order of "
"preference:\n"
"\"int\", \"float\" and \"text\".\n"
"\n"
"Can be used with an arbitrary number of arguments.  Multi-value arguments\n"
"will be expanded automatically.\n"
"\n"
"_Since Picard 2.9_"
msgstr ""
"Returnerar det största värdet enligt jämförelsen som anges i `type`.\n"
"\n"
"Möjliga värden för `type` är \"int\" (heltal), \"float\" (flyttal), "
"\"text\"\n"
"(skiftlägeskänslig text), \"nocase\" (text utan hänsyn till skiftläge) och "
"\"auto\" (automatisk\n"
"bestämning av argumentens typ). \"auto\" används som förvald jämförelsemetod "
"om `type` inte anges. Typen \"auto\" använder den\n"
"första typ som passar båda argumenten i följande prioritetsordning:\n"
"\"int\", \"float\" och \"text\".\n"
"\n"
"Kan användas med valfritt antal argument. Flervärdesargument\n"
"expanderas automatiskt.\n"
"\n"
"_Sedan Picard 2.9_"

