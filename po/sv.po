#: picard/ui/options/genres.py:41
msgid ""
"<html><head/><body>\n"
"<p>Lines not starting with <b>-</b> or <b>+</b> are ignored.</p>\n"
"<p>One expression per line, case-insensitive</p>\n"
"<p>Examples:</p>\n"
"<p><b>\n"
"#comment<br/>\n"
"!comment<br/>\n"
"comment\n"
"</b></p>\n"
"<p><u>Strict filtering:</u></p>\n"
"<p>\n"
"<b>-word</b>: exclude <i>word</i><br/>\n"
"<b>+word</b>: include <i>word</i>\n"
"</p>\n"
"<p><u>Wildcard filtering:</u></p>\n"
"<p>\n"
"<b>-*word</b>: exclude all genres ending with <i>word</i><br/>\n"
"<b>+word*</b>: include all genres starting with <i>word</i><br/>\n"
"<b>+wor?</b>: include all genres starting with <i>wor</i> and ending with an "
"arbitrary character<br/>\n"
"<b>+wor[dk]</b>: include all genres starting with <i>wor</i> and ending with "
"<i>d</i> or <i>k</i><br/>\n"
"<b>-w*rd</b>: exclude all genres starting with <i>w</i> and ending with "
"<i>rd</i>\n"
"</p>\n"
"<p><u>Regular expressions filtering (Python re syntax):</u></p>\n"
"<p><b>-/^w.rd+/</b>: exclude genres starting with <i>w</i> followed by any "
"character, then <i>r</i> followed by at least one <i>d</i>\n"
"</p>\n"
"</body></html>"
msgstr ""
"<html><head/><body>\n"
"<p>Rader som inte börjar med <b>-</b> eller <b>+</b> ignoreras.</p>\n"
"<p>Ett uttryck per rad, utan hänsyn till skiftläge</p>\n"
"<p>Exempel:</p>\n"
"<p><b>\n"
"#kommentar<br/>\n"
"!kommentar<br/>\n"
"kommentar\n"
"</b></p>\n"
"<p><u>Strikt filtrering:</u></p>\n"
"<p>\n"
"<b>-ord</b>: uteslut <i>ord</i><br/>\n"
"<b>+ord</b>: inkludera <i>ord</i>\n"
"</p>\n"
"<p><u>Filtrering med jokertecken:</u></p>\n"
"<p>\n"
"<b>-*ord</b>: uteslut alla genrer som slutar med <i>ord</i><br/>\n"
"<b>+ord*</b>: inkludera alla genrer som börjar med <i>ord</i><br/>\n"
"<b>+wor?</b>: inkludera alla genrer som börjar med <i>wor</i> och slutar med "
"ett valfritt tecken<br/>\n"
"<b>+wor[dk]</b>: inkludera alla genrer som börjar med <i>wor</i> och slutar "
"med <i>d</i> eller <i>k</i><br/>\n"
"<b>-w*rd</b>: uteslut alla genrer som börjar med <i>w</i> och slutar med "
"<i>rd</i>\n"
"</p>\n"
"<p><u>Filtrering med reguljära uttryck (Python re-syntax):</u></p>\n"
"<p><b>-/^w.rd+/</b>: uteslut genrer som börjar med <i>w</i>, följt av "
"valfritt tecken, därefter <i>r</i> och minst ett <i>d</i>\n"
"</p>\n"
"</body></html>"

